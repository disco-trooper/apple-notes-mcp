{
  "name": "@disco_trooper/apple-notes-mcp",
  "version": "1.3.0",
  "description": "MCP server for Apple Notes with semantic search and CRUD operations",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "setup": "bun run src/setup.ts",
    "dev": "bun --watch run src/index.ts",
    "check": "bun run tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.0",
    "@huggingface/transformers": "^3.0.0",
    "@lancedb/lancedb": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "apache-arrow": "^21.1.0",
    "dotenv": "^16.4.0",
    "marked": "^15.0.0",
    "run-jxa": "^3.0.0",
    "turndown": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/turndown": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.7.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "mcp",
    "apple-notes",
    "semantic-search",
    "rag",
    "claude"
  ],
  "author": "disco-trooper",
  "license": "MIT",
  "bin": {
    "apple-notes-mcp": "./src/index.ts",
    "apple-notes-mcp-setup": "./src/setup.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/disco-trooper/apple-notes-mcp"
  }
}
